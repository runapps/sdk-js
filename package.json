{
  "name": "@runappsai/sdk",
  "version": "0.14.4",
  "description": "JavaScript / TypeScript client for the RunApps AI Gateway",
  "license": "MIT",
  "author": "RunApps",
  "homepage": "https://github.com/runapps/sdk-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runapps/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/runapps/sdk-js/issues"
  },
  "keywords": [
    "runapps",
    "ai",
    "llm",
    "gateway",
    "sdk",
    "openai-compatible"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/sdk.umd.js",
  "jsdelivr": "./dist/sdk.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/sdk.umd.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsup",
    "clean": "rm -rf dist",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "release:cdn": "bash scripts/publish-cdn.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  }
}
